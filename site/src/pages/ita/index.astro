---
import Base from "../../layouts/Base.astro";
import catalogo from "../../data/catalogo.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ita = catalogo.instituicoes.find((i) => i.id === "ita");
const anos = Object.keys(ita.anos).sort((a, b) => Number(b) - Number(a));
---
<Base titulo="ITA — escolha o ano">
  <h2>ITA — escolha o ano</h2>
  <label for="filtro-ano" class="suave">Buscar ano</label>
  <input type="search" id="filtro-ano" placeholder="Ex.: 2019" inputmode="numeric" autocomplete="off" />
  <ul class="grade-anos" id="lista-anos">
    {anos.map((ano) => (
      <li data-ano={ano}><a href={`${base}/ita/${ano}/`}>{ano}</a></li>
    ))}
  </ul>
  <p id="sem-resultado" class="pendente" hidden>Nenhum ano corresponde à busca.</p>
  <script>
    const campo = document.getElementById("filtro-ano");
    const itens = [...document.querySelectorAll("#lista-anos li")];
    const aviso = document.getElementById("sem-resultado");
    campo.addEventListener("input", () => {
      const q = campo.value.trim();
      let visiveis = 0;
      for (const li of itens) {
        const mostra = !q || li.dataset.ano.includes(q);
        li.hidden = !mostra;
        if (mostra) visiveis++;
      }
      aviso.hidden = visiveis > 0;
    });
  </script>
</Base>
